#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
# Безопасное чтение одного ключа из /mnt/flash/tc.conf (формат KEY=VALUE).
# НАМЕРЕННО не исполняет файл (никакого `source`/eval) — читает только
# указанный ключ, поэтому произвольный код с флешки выполнить нельзя.
# Использование: value=$(tc-getconf RDP_USER)
#   - строки, начинающиеся с '#', игнорируются;
#   - берётся первое вхождение ключа;
#   - хвостовой \r (правка в Windows) срезается;
#   - окаймляющие кавычки (' или ") снимаются.
CONF=/mnt/flash/tc.conf
[ -f "$CONF" ] || exit 0

# имя ключа — только латиница/цифры/подчёркивание (защита от инъекции в sed)
case "$1" in
    ''|*[!A-Za-z0-9_]*) exit 0 ;;
esac

val=$(sed -n "s/^${1}=//p" "$CONF" | grep -v '^#' | head -1 | tr -d '\r')
# снять окаймляющие кавычки
case "$val" in
    \"*\") val=${val#\"}; val=${val%\"} ;;
    \'*\') val=${val#\'}; val=${val%\'} ;;
esac
printf '%s\n' "$val"
