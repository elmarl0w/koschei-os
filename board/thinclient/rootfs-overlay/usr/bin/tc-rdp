#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
# tc-rdp — подключение к RDP из консоли, для отладки.
#
#   tc-rdp <ip[:port]> [доп-флаги xfreerdp...]
#   tc-rdp -v <ip[:port]>     подробный лог FreeRDP (/log-level:DEBUG)
#   tc-rdp -n <ip[:port]>     dry-run: показать команду и проверки, не подключаться
#
# Собирает ТУ ЖЕ команду, что и меню (tc-session): протокол и логин — из
# строки сервера в servers.conf (имя;адрес;протокол;логин), дефолтный логин
# и RDP_EXTRA — из tc.conf. Перед стартом показывает команду и TCP-проверку.
# Лог сессии: /tmp/tc-rdp.log (хвост печатается после выхода).
# Запускать с локальной консоли (Settings -> Console); по SSH X может не
# подняться (нужен свободный VT).

LOG=/tmp/tc-rdp.log
CONF=/mnt/flash/servers.conf

usage() {
    echo "usage: tc-rdp [-v|-n] <ip[:port]> [extra xfreerdp flags...]" >&2
    echo "  -v  verbose FreeRDP log (/log-level:DEBUG)" >&2
    echo "  -n  dry-run: print command and checks, do not connect" >&2
    exit 1
}

VERBOSE=""
DRY=0
while [ $# -gt 0 ]; do
    case "$1" in
        -v) VERBOSE="/log-level:DEBUG"; shift ;;
        -n) DRY=1; shift ;;
        -*) usage ;;
        *)  break ;;
    esac
done
SRV="$1"
[ -n "$SRV" ] || usage
shift
EXTRAS="$*"          # доп. флаги пользователя (после адреса)

# поля этого сервера из servers.conf: 3=протокол, 4=логин
_srv_field() {   # $1 = адрес, $2 = номер поля
    awk -F';' -v a="$1" -v n="$2" '
        /^#/ { next }
        { gsub(/[ \r]/,"",$2); if ($2==a) { gsub(/\r/,"",$n); print $n; exit } }
    ' "$CONF" 2>/dev/null
}
SEC=$(_srv_field "$SRV" 3)
RDP_USER=$(_srv_field "$SRV" 4)
[ -n "$RDP_USER" ] || RDP_USER=$(/usr/bin/tc-getconf RDP_USER)
RDP_EXTRA=$(/usr/bin/tc-getconf RDP_EXTRA)

set -- /f /v:"$SRV" /cert:ignore /bpp:16 +clipboard /dynamic-resolution
[ -n "$RDP_USER" ]   && set -- "$@" /u:"$RDP_USER"
case "$SEC" in
    rdp|tls|nla|ext) set -- "$@" /sec:"$SEC" ;;
esac
# легаси-серверы: без этого сессия рвётся при первом вводе (см. tc-session)
case "$SEC" in
    rdp) set -- "$@" /relax-order-checks +glyph-cache ;;
esac
if [ -n "$(/usr/bin/tc-getconf PRINTER)" ] && \
   [ -e /usr/lib/freerdp2/libprinter-client.so ]; then
    set -- "$@" /printer
fi
[ -n "$VERBOSE" ] && set -- "$@" "$VERBOSE"

echo ">> server:    $SRV"
echo ">> security:  ${SEC:-auto (negotiate)}"
echo ">> login:     ${RDP_USER:-<ask at logon>}"
echo ">> command:   xfreerdp $* $RDP_EXTRA $EXTRAS"

# TCP-проверка порта — диагностика (подключаться пробуем в любом случае)
H=${SRV%%:*}
case "$SRV" in *:*) P=${SRV##*:} ;; *) P=3389 ;; esac
if command -v timeout >/dev/null 2>&1 && [ -x /bin/bash ]; then
    if timeout 4 /bin/bash -c "exec 3<>/dev/tcp/$H/$P" 2>/dev/null; then
        echo ">> tcp $H:$P  OPEN"
    else
        echo ">> tcp $H:$P  CLOSED/FILTERED (all the same, trying to connect)"
    fi
fi

[ "$DRY" = 1 ] && { echo ">> dry-run, not connecting"; exit 0; }

# RDP_EXTRA/EXTRAS намеренно без кавычек — это наборы флагов
if [ -n "$DISPLAY" ]; then
    xfreerdp "$@" $RDP_EXTRA $EXTRAS 2>&1 | tee "$LOG"
    rc=$?
else
    echo ">> starting X (log: $LOG) ..."
    XDRV=$(/usr/bin/tc-xconf 2>/dev/null)
    echo ">> xdriver:   $XDRV (kms=$([ -e /dev/dri/card0 ] && echo yes || echo no), fb0=$(cat /sys/class/graphics/fb0/name 2>/dev/null || echo none))"
    xinit /usr/bin/xfreerdp "$@" $RDP_EXTRA $EXTRAS -- -nolisten tcp >"$LOG" 2>&1
    rc=$?
    chvt 1 2>/dev/null
    echo ">> last log lines:"
    tail -15 "$LOG"
fi
echo ">> xfreerdp exit code: $rc   (full log: $LOG)"
exit "$rc"
