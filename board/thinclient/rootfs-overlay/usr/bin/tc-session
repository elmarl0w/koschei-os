#!/bin/sh
# Запускается внутри X через xinit: единственный клиент X-сервера — полноэкранный RDP.
# FreeRDP 2.11: RDP 7-10 (Windows Server 2008 R2 - 2022), NLA + TLS 1.2.
#   /f                   — во весь экран в нативном разрешении монитора (KMS)
#   /dynamic-resolution  — сессия подстраивается при смене разрешения
#   /printer             — проброс принтеров (добавляется ТОЛЬКО если задан
#                          PRINTER и есть плагин канала, иначе рвёт коннект)
#   /bpp:16 разгружает старые Атомы; убери, если нужна полная цветность.
# Настройки КОНКРЕТНОГО сервера — поля его строки в servers.conf:
#   имя;адрес;протокол;логин
# Логин сервера важнее дефолтного RDP_USER из tc.conf. Домена нет: если
# нужен — пишется в логине (CORP\user или user@corp.local).
# Пароль пользователь вводит сам. Код выхода xfreerdp уходит в
# /tmp/rdp-status — по нему tc-menu показывает экран ошибки.

SRV="$1"

_srv_field() {   # $1 = адрес, $2 = номер поля (3=протокол, 4=логин)
    awk -F';' -v a="$1" -v n="$2" '
        /^#/ { next }
        { gsub(/[ \r]/,"",$2); if ($2==a) { gsub(/\r/,"",$n); print $n; exit } }
    ' /mnt/flash/servers.conf 2>/dev/null
}

RDP_SEC=$(_srv_field "$SRV" 3)           # протокол берётся ТОЛЬКО у сервера
RDP_USER=$(_srv_field "$SRV" 4)          # логин сервера, иначе дефолт tc.conf
[ -n "$RDP_USER" ] || RDP_USER=$(/usr/bin/tc-getconf RDP_USER)
RDP_EXTRA=$(/usr/bin/tc-getconf RDP_EXTRA)

set -- /f /v:"$SRV" /cert:ignore /bpp:16 +clipboard /dynamic-resolution
[ -n "$RDP_USER" ]   && set -- "$@" /u:"$RDP_USER"
# Протокол безопасности: rdp = обычный RDP (без NLA/TLS — как `-sec-nla -sec-tls`),
# tls/nla = только TLS/NLA. Пусто = авто-согласование (по умолчанию).
case "$RDP_SEC" in
    rdp|tls|nla|ext) set -- "$@" /sec:"$RDP_SEC" ;;
esac
# Легаси-серверы (обычный RDP security — старые Windows): без этих флагов
# сессия ОТКРЫВАЕТСЯ, но рвётся при первом вводе (мышь/клавиатура вызывают
# отрисовку, сервер шлёт старые draw-orders/глифы, строгая проверка FreeRDP
# их бракует -> disconnect). Канонический фикс FreeRDP для 2003/2008-эпохи.
if [ "$RDP_SEC" = "rdp" ]; then
    set -- "$@" /relax-order-checks +glyph-cache
fi
# Проброс принтера — ТОЛЬКО если принтер настроен И плагин канала собран.
# ВАЖНО: без libprinter-client.so флаг /printer роняет ВСЁ соединение
# (rdpdr -> ERRCONNECT_CONNECT_CANCELLED), а не просто отключает печать.
if [ -n "$(/usr/bin/tc-getconf PRINTER)" ] && \
   [ -e /usr/lib/freerdp2/libprinter-client.so ]; then
    set -- "$@" /printer
fi

# RDP_EXTRA намеренно без кавычек — это набор доп. флагов из tc.conf
xfreerdp "$@" $RDP_EXTRA
rc=$?
echo "$rc" > /tmp/rdp-status
exit "$rc"
