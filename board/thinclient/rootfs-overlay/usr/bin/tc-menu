#!/bin/sh
# Обёртка вокруг tc-launcher (ncurses-интерфейс). Крутится на tty1 вместо
# getty (см. /etc/inittab): лаунчер рисует UI и пишет выбор в /tmp/tc-choice,
# здесь выбор исполняется — RDP-сессия, консоль, запись сервера, питание.

CONF=/mnt/flash/servers.conf
PASS_FILE=/mnt/flash/shell.pass
OUT=/tmp/tc-choice
TAB=$(printf '\t')
export TERM=linux

# Экран ввода пароля на Settings рисует лаунчер (tc-launcher --password) —
# ncurses-оболочка со звёздочками, как остальные меню (см. check_pass).

# есть ли глобальный IPv4 (не lo, не link-local)
_has_ip() {
    ip -4 -o addr show scope global 2>/dev/null | grep -q .
}

# заблокировать до нажатия любой клавиши
_anykey() {
    _sv=$(stty -g 2>/dev/null)
    stty -echo -icanon min 1 time 0 2>/dev/null
    dd bs=1 count=1 >/dev/null 2>&1
    if [ -n "$_sv" ]; then stty "$_sv" 2>/dev/null; else stty sane 2>/dev/null; fi
}

# Ждать IP перед показом меню, если задан tc.conf WAIT_FOR_IP=<секунды>.
# Любая клавиша — пропустить сразу. По таймауту без IP — экран «обратитесь к
# администратору», потом любая клавиша -> меню. Никогда не запирает насмерть.
wait_for_ip() {
    secs=$(/usr/bin/tc-getconf WAIT_FOR_IP)
    case "$secs" in ''|0|*[!0-9]*) return 0 ;; esac   # не задано/не число -> не ждём
    _has_ip && return 0
    /usr/bin/tc-netup 2>/dev/null                     # убедиться, что udhcpc поднят (он ретраит сам)
    _sv=$(stty -g 2>/dev/null)
    stty -echo -icanon min 0 time 10 2>/dev/null      # dd ждёт клавишу до ~1с
    left=$secs
    while [ "$left" -gt 0 ]; do
        clear
        echo "Waiting for network (IP address)... ${left}s"
        echo
        echo "(press any key to skip)"
        key=$(dd bs=1 count=1 2>/dev/null)            # клавиша ИЛИ ~1с таймаут
        if [ -n "$key" ] || _has_ip; then
            if [ -n "$_sv" ]; then stty "$_sv" 2>/dev/null; else stty sane 2>/dev/null; fi
            return 0
        fi
        left=$((left - 1))
    done
    if [ -n "$_sv" ]; then stty "$_sv" 2>/dev/null; else stty sane 2>/dev/null; fi
    clear
    echo "=== No network connection ==="
    echo
    echo "The thin client did not get an IP address."
    echo "Please contact your administrator."
    echo
    printf "Press any key to continue..."
    _anykey
    printf '\n'
}

save_server() {   # $1=имя $2=адрес $3=протокол(опц.)
    # формат не должен ломаться, что бы ни пришло: точки с запятой и
    # переводы строк из полей выкидываем
    name=$(printf '%s' "$1" | tr -d ';\r\n')
    addr=$(printf '%s' "$2" | tr -d ';\r\n ')
    sec=$(printf '%s' "$3"  | tr -d ';\r\n ')
    [ -n "$name" ] && [ -n "$addr" ] || return
    if [ -n "$sec" ]; then row="$name;$addr;$sec"; else row="$name;$addr"; fi

    mount -o remount,rw /mnt/flash 2>/dev/null
    # если файл не кончается переводом строки — новая запись приклеится
    # к последней (так один раз и похерился conf), добиваем разделитель
    if [ -s "$CONF" ] && [ -n "$(tail -c1 "$CONF" 2>/dev/null)" ]; then
        printf '\r\n' >> "$CONF" 2>/dev/null
    fi
    if printf '%s\r\n' "$row" >> "$CONF" 2>/dev/null; then
        sync
    else
        clear
        echo "Cannot save: read-only media (ISO image)."
        echo "Persistent server list needs the usb.img build."
        sleep 2
    fi
    mount -o remount,ro /mnt/flash 2>/dev/null
}

# Перезаписать servers.conf: строку, ТОЧНО совпадающую с $1, заменить на $2
# (пусто → удалить). Остальные строки (в т.ч. комментарии) сохраняются как есть.
# ключ сервера — первые два поля строки «имя;адрес» (без CR); 3-е поле
# (протокол) в ключ не входит, чтобы delete/edit находили строку независимо
# от того, задан у сервера протокол или нет.
_key2() { printf '%s' "$1" | tr -d '\r' | cut -d';' -f1-2; }

_rewrite_conf() {
    old=$1; new=$2        # old = ключ «имя;адрес»; new = полная строка или пусто
    [ -f "$CONF" ] || return
    if ! mount -o remount,rw /mnt/flash 2>/dev/null; then
        clear
        echo "Read-only media — cannot modify the server list."
        sleep 2
        return
    fi
    oldk=$(_key2 "$old")
    tmp="$CONF.tmp"
    while IFS= read -r ln || [ -n "$ln" ]; do
        if [ "$(_key2 "$ln")" = "$oldk" ]; then
            [ -n "$new" ] && printf '%s\r\n' "$new"
        else
            printf '%s\n' "$ln"
        fi
    done < "$CONF" > "$tmp"
    mv "$tmp" "$CONF" 2>/dev/null && sync
    mount -o remount,ro /mnt/flash 2>/dev/null
}

delete_server() { _rewrite_conf "$1" ""; }      # $1 = ключ "name;ip"
edit_server()   { _rewrite_conf "$1" "$2"; }     # $1 = ключ, $2 = новая строка

# Раздел Settings (управление серверами, сеть/RDP, принтер, диагностика,
# консоль) по умолчанию БЕЗ пароля. Админ может запаролить весь вход в него:
# положить на флешку shell.pass с sha256-хэшем пароля — тогда Settings спросит
# его (и консоль внутри тоже закрыта). Забыл пароль — удали файл.
# Создать: printf '%s' 'пароль' | sha256sum | cut -c1-64 > /mnt/flash/shell.pass
check_pass() {
    [ -f "$PASS_FILE" ] || return 0
    stored=$(tr -d ' \t\r\n' < "$PASS_FILE")
    msg=""
    tries=3
    while [ "$tries" -gt 0 ]; do
        rm -f "$OUT"
        # ncurses-экран пароля в стиле меню (звёздочки, q/Esc). Лаунчер НЕ в
        # $() — он рисует в stdout; пароль читаем из файла $OUT. rc: 0 ввёл,
        # 1 отмена (q/Esc) — тогда назад в меню (бухгалтер не застрянет).
        if ! /usr/bin/tc-launcher --password "Settings (locked)" "$msg"; then
            return 1
        fi
        pw=$(cat "$OUT" 2>/dev/null)
        rm -f "$OUT"
        hash=$(printf '%s' "$pw" | sha256sum | cut -c1-64)
        [ "$hash" = "$stored" ] && return 0
        tries=$((tries - 1))
        msg="Wrong password, $tries left"
    done
    return 1
}

open_shell() {
    # Пароль спрашивается на входе в весь раздел Settings (run_settings),
    # отдельного гейта на консоль уже не нужно.
    clear
    echo "=== Linux console (root). Back to menu: exit or Ctrl-D ==="
    echo "Flash is mounted read-only. To edit files on it use:"
    echo "  tc-edit            edit servers.conf"
    echo "  tc-edit <file>     edit any file on /mnt/flash"
    # HOME обязателен: без него bash -l не найдёт /root/.bash_profile
    # и останется с голым PS1='# ' из скелетного /etc/profile
    export HOME=/root
    cd /root
    if [ -x /bin/bash ]; then
        /bin/bash -l
    else
        /bin/sh -l
    fi
    cd /
}

# Быстрая проверка доступности RDP-порта БЕЗ запуска X. Неответивший сервер
# (неверный IP, сервер выключен, чужая сеть — напр. NAT в UTM) иначе даёт
# чёрный экран на всё время таймаута xfreerdp. Тут через bash /dev/tcp
# (net-redirections в bash) + timeout: нет коннекта за 4с → ошибка сразу.
# ВАЖНО: это ОПТИМИЗАЦИЯ, не гейт — fail-OPEN. Нет timeout/bash → возвращаем
# 0 (доступен), чтобы НЕ блокировать подключение (иначе всё «unreachable»,
# даже открытые порты — так и было, когда timeout не собрался).
_rdp_reachable() {   # $1 = host | host:port ; 0 = доступен/проверить нечем, 1 = закрыт
    command -v timeout >/dev/null 2>&1 || return 0
    [ -x /bin/bash ] || return 0
    _h=${1%%:*}
    case "$1" in
        *:*) _p=${1##*:} ;;
        *)   _p=3389 ;;
    esac
    timeout 4 /bin/bash -c "exec 3<>/dev/tcp/$_h/$_p" 2>/dev/null
}

run_session() {   # $1 = сервер; rc: 0 ок, 254 недоступен, 255 X не поднялся
    clear
    echo "Connecting to $1 ..."
    rm -f /tmp/rdp-status
    # сервера не видно — не поднимаем X (иначе чёрный экран на таймаут)
    if ! _rdp_reachable "$1"; then
        echo "unreachable: no TCP connect to $1 (RDP port)" > /var/log/xsession.log
        echo 254 > /tmp/rdp-status
        return 254
    fi
    # X живёт только пока идёт RDP-сессия; вышел из Windows — вернулся в меню
    xinit /usr/bin/tc-session "$1" -- -nolisten tcp >/var/log/xsession.log 2>&1
    # если X умер грязно и оставил VT в графическом режиме — вернуть консоль
    chvt 1 2>/dev/null
    rc=$(cat /tmp/rdp-status 2>/dev/null)
    [ -n "$rc" ] || rc=255
    return "$rc"
}

connect() {   # ручное подключение из меню: при провале — экран ошибки
    run_session "$1"
    rc=$?
    if [ "$rc" = 254 ]; then
        connect_error "$1" "server unreachable — no route or RDP port closed"
    elif [ "$rc" = 255 ]; then
        connect_error "$1" "X server failed to start"
    elif [ "$rc" != 0 ]; then
        connect_error "$1" "xfreerdp exited with code $rc"
    fi
}

# Киоск-failover: AUTOCONNECT может быть списком через запятую. Пробуем по
# порядку до первой НОРМАЛЬНО завершившейся сессии (rc 0 = пользователь
# вышел сам). Если ни один не поднялся — один экран ошибки.
autoconnect_list() {
    last=""
    OLDIFS=$IFS
    IFS=,
    for srv in $1; do
        IFS=$OLDIFS
        srv=$(printf '%s' "$srv" | tr -d ' \t\r')
        [ -n "$srv" ] || { IFS=,; continue; }
        last="$srv"
        run_session "$srv" && return 0
        IFS=,
    done
    IFS=$OLDIFS
    [ -n "$last" ] && connect_error "$last" "autoconnect: no server reachable"
    return 1
}

connect_error() {
    clear
    echo "=== Connection to $1 failed ($2) ==="
    echo
    echo "Last errors from /var/log/xsession.log:"
    grep -iE 'ERR|error|denied|refused|timeout|unreachable|failed' \
        /var/log/xsession.log | tail -6
    echo
    echo "Check: server address, network cable, ip in the corner of the menu."
    echo "Full log: console -> less /var/log/xsession.log"
    echo
    printf "Press any key to return to the menu..."
    _anykey
    printf '\n'
}

# Экран диагностики: сеть, ping до шлюза, последние ошибки RDP-сессии.
# Без ухода в шелл — всё из меню.
run_diag() {
    clear
    echo "=== Diagnostics ==="
    echo "Host: $(hostname)   Version: $(cat /etc/tc-release 2>/dev/null)"
    echo
    echo "-- Interfaces --"
    ip -br addr 2>/dev/null | grep -v '^lo '
    echo "-- Routes --"
    ip route 2>/dev/null
    echo "-- DNS --"
    grep -v '^#' /etc/resolv.conf 2>/dev/null
    echo
    GW=$(ip route 2>/dev/null | awk '/^default/{print $3; exit}')
    if [ -n "$GW" ]; then
        echo "-- Ping gateway $GW --"
        ping -c 2 -W 1 "$GW" 2>&1 | tail -2
    else
        echo "(no default gateway)"
    fi
    echo
    echo "-- Last RDP session errors --"
    grep -iE 'error|denied|refused|timeout|unreachable|failed' \
        /var/log/xsession.log 2>/dev/null | tail -5
    echo
    printf "Press any key to return to the menu..."
    _anykey
    printf '\n'
}

# Раздел Settings — единый админ-экран из меню. Все экраны рисует лаунчер в
# режиме --menu (стрелки+Enter, тот же тёмный стиль, что и главный экран), а
# tc-menu исполняет выбор. Правка tc.conf идёт безопасным tc-setconf (ремоунт
# rw/ro, без eval). Вход в раздел опционально паролится (check_pass/shell.pass).
SET=/usr/bin/tc-setconf
GET=/usr/bin/tc-getconf
UIITEMS=/tmp/tc-menu-items

_net_mode() {
    ip=$($GET STATIC_IP)
    if [ -n "$ip" ]; then echo "static $ip"; else echo "DHCP"; fi
}

# true, если на флешку можно писать (не ISO): тестовый ремоунт rw→ro.
_flash_rw_ok() {
    mount -o remount,rw /mnt/flash 2>/dev/null || return 1
    mount -o remount,ro /mnt/flash 2>/dev/null
    return 0
}

# Интерактивное меню через лаунчер (стрелки+Enter). $1 — заголовок; далее
# пункты по одному аргументу:
#   "#Секция"          — некликабельный заголовок
#   "label"            — пункт
#   "label<TAB>right"  — пункт + правая колонка (текущее значение)
# Результат кладём в глобальную UICHOICE: индекс выбранного пункта (0-based
# среди кликабельных) или BACK (q/Esc).
# ВАЖНО: лаунчер (ncurses) рисует в stdout — его НЕЛЬЗЯ звать внутри $(...),
# иначе вывод уйдёт в пайп, а не на экран. Поэтому результат читаем из файла
# $OUT в переменную, как это делает главный цикл.
ui_menu() {
    _title=$1; shift
    : > "$UIITEMS"
    for _it in "$@"; do
        printf '%s\n' "$_it" >> "$UIITEMS"
    done
    rm -f "$OUT"
    /usr/bin/tc-launcher --menu "$_title" "$UIITEMS"
    UICHOICE=$(cat "$OUT" 2>/dev/null)
}

_note() { clear; echo "$1"; sleep 2; }

# короткие сводки для правой колонки главного экрана Settings.
# ВНИМАНИЕ: весь видимый в меню текст — только латиница: консольный шрифт на
# tty1 не рисует кириллицу (получается мусор). Комментарии — можно по-русски.
_rdp_summary() {
    _u=$($GET RDP_USER); _d=$($GET RDP_DOMAIN)
    [ -n "$_d" ] && _u="$_d\\$_u"
    [ -n "$_u" ] && printf '%s' "$_u" || printf '%s' '-'
}
_printer_summary() {
    _p=$($GET PRINTER)
    [ -n "$_p" ] && printf '%s' "$_p" || printf '%s' '-'
}

# Правка одного текстового ключа: Enter пустым — оставить; '-' — очистить.
set_key() {   # $1=KEY  $2=подпись
    cur=$($GET "$1")
    clear
    echo "=== $2 ==="
    echo "Current: ${cur:-<empty>}"
    echo "Empty = keep as is;  '-' = clear."
    printf "New value: "
    read -r v
    [ -z "$v" ] && return
    [ "$v" = "-" ] && v=""
    if ! $SET "$1" "$v"; then
        echo "Not saved (read-only media?)"
        sleep 2
    fi
}

set_network() {
    if ! _flash_rw_ok; then
        _note "Read-only media (ISO) - cannot save network settings to tc.conf."
        return
    fi
    ui_menu "Network (now: $(_net_mode))" \
        "DHCP - obtain address automatically" \
        "Static IP"
    case "$UICHOICE" in
        0)
            $SET STATIC_IP ""; $SET GATEWAY ""; $SET DNS ""
            _note "Switched to DHCP. Applies after reboot (or tc-netup)."
            ;;
        1)
            clear
            echo "=== Static IP ==="
            printf "IP/mask (e.g. 192.168.0.50/24): "; read -r a
            [ -n "$a" ] && $SET STATIC_IP "$a"
            printf "Gateway (e.g. 192.168.0.1): ";     read -r g
            [ -n "$g" ] && $SET GATEWAY "$g"
            printf "DNS (e.g. 192.168.0.1): ";         read -r d
            [ -n "$d" ] && $SET DNS "$d"
            _note "Saved. Applies after reboot (or tc-netup)."
            ;;
        *) ;;
    esac
}

# Под-экран «RDP по умолчанию»: логин, домен, автоподключение.
# Протокол (rdp/tls/nla) НЕ здесь — он привязан к серверу (Manage servers).
rdp_defaults_menu() {
    while true; do
        ui_menu "RDP defaults" \
            "Login${TAB}$($GET RDP_USER)" \
            "Domain${TAB}$($GET RDP_DOMAIN)" \
            "Autoconnect${TAB}$($GET AUTOCONNECT)"
        case "$UICHOICE" in
            0) set_key RDP_USER    "Default RDP login" ;;
            1) set_key RDP_DOMAIN  "Default RDP domain" ;;
            2) set_key AUTOCONNECT "Autoconnect (IP or comma-separated list)" ;;
            *) return ;;
        esac
    done
}

# Под-экран «Принтер»: сетевой принтер, пробрасываемый в RDP-сессию.
printer_menu() {
    while true; do
        ui_menu "Printer (RDP redirect)" \
            "Printer URI${TAB}$($GET PRINTER)" \
            "Queue name${TAB}$($GET PRINTER_NAME)"
        case "$UICHOICE" in
            0) set_key PRINTER      "Network printer URI (socket://ip:9100, lpd://ip/queue, ipp://host/...)" ;;
            1) set_key PRINTER_NAME "Printer queue name (as Windows sees it; default: printer)" ;;
            *) return ;;
        esac
    done
}

# Единый админ-экран Settings. Вход опционально паролится (shell.pass).
# Диагностика и консоль работают и на read-only носителе; правка tc.conf/
# серверов на ISO честно упрётся в «только чтение» на своём шаге.
run_settings() {
    check_pass || return
    while true; do
        ui_menu "Settings" \
            "#Servers" \
            "Manage servers${TAB}add / edit / delete" \
            "#System" \
            "Console${TAB}root shell" \
            "Diagnostics${TAB}network / ping / logs" \
            "#Network & RDP" \
            "Network${TAB}$(_net_mode)" \
            "RDP defaults${TAB}$(_rdp_summary)" \
            "Printer${TAB}$(_printer_summary)"
        case "$UICHOICE" in
            0) manage_loop ;;
            1) open_shell ;;
            2) run_diag ;;
            3) set_network ;;
            4) rdp_defaults_menu ;;
            5) printer_menu ;;
            *) return ;;      # BACK / пусто
        esac
    done
}

# Экран управления серверами: лаунчер в режиме --manage возвращает одно
# действие (ADD/EDIT/DELETE/BACK), применяем и снова показываем экран,
# пока не BACK/пусто. Вывод лаунчера НЕ перехватываем (ncurses рисует в
# терминал) — действие читаем из файла $OUT.
manage_loop() {
    while true; do
        rm -f "$OUT"
        /usr/bin/tc-launcher --manage
        a=$(cat "$OUT" 2>/dev/null)
        case "$a" in
            ADD\ *)
                entry=${a#ADD }              # имя;адрес;протокол
                name=${entry%%;*}
                rest=${entry#*;}             # адрес;протокол
                addr=${rest%%;*}
                if [ "$rest" = "$addr" ]; then sec=""; else sec=${rest#*;}; fi
                [ -n "$name" ] && [ -n "$addr" ] && save_server "$name" "$addr" "$sec"
                ;;
            DELETE\ *)
                delete_server "${a#DELETE }"
                ;;
            EDIT\ *)
                rest=${a#EDIT }
                old=${rest%%"$TAB"*}
                new=${rest#*"$TAB"}
                [ "$old" != "$new" ] && edit_server "$old" "$new"
                ;;
            *)
                break
                ;;
        esac
    done
}

while true; do
    # сеть могла появиться позже загрузки — лаунчер покажет ip, как только он есть
    _has_ip || /usr/bin/tc-netup 2>/dev/null

    # ждать IP перед первым показом меню (tc.conf WAIT_FOR_IP), один раз за загрузку
    if [ ! -f /tmp/tc-ipwait-done ]; then
        : > /tmp/tc-ipwait-done
        wait_for_ip
    fi

    # киоск: автоподключение ОДИН раз за загрузку (tc.conf AUTOCONNECT).
    # Флаг ставим до connect — если сервер недоступен, показываем меню,
    # а не зацикливаемся на автоконнекте (админ должен добраться до меню).
    if [ ! -f /tmp/tc-autodone ]; then
        : > /tmp/tc-autodone
        auto=$(/usr/bin/tc-getconf AUTOCONNECT)
        if [ -n "$auto" ]; then
            autoconnect_list "$auto"
            continue
        fi
    fi

    rm -f "$OUT"
    /usr/bin/tc-launcher
    action=$(cat "$OUT" 2>/dev/null)

    # Главный экран отдаёт только эти действия. Управление серверами,
    # диагностика и консоль теперь внутри Settings (run_settings).
    case "$action" in
        CONNECT\ *)
            connect "${action#CONNECT }"
            ;;
        SETTINGS)
            run_settings
            ;;
        REBOOT)
            reboot
            ;;
        POWEROFF)
            poweroff
            ;;
        *)
            # лаунчер умер без выбора — не крутить respawn бешено
            sleep 1
            ;;
    esac
done
