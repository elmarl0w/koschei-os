# tc.conf — необязательный конфиг тонкого клиента. Кладётся на флешку рядом
# с servers.conf (FAT-раздел / TCDATA). Формат: KEY=значение, по одному в
# строке; строки с # — комментарии. Файл НЕ исполняется (только чтение
# известных ключей), так что вписывать сюда shell-команды бессмысленно.
#
# Значения — латиницей. Убери # перед нужной строкой.

# --- RDP: дефолтный логин --------------------------------------------------
# Подставляется в окно входа, если у сервера в servers.conf не задан свой
# (4-е поле). Домен, если нужен, пишется в логине: CORP\user, user@corp.local.
# Пароль пользователь вводит сам.
#RDP_USER=ivanov

# Протокол и логин КОНКРЕТНОГО сервера — поля 3/4 его строки в servers.conf:
# имя;адрес;протокол;логин (протокол: rdp = без NLA/TLS, tls, nla; пусто =
# авто). Правится из меню Manage servers (Enter на сервере).

# Любые доп. флаги xfreerdp (через пробел). Примеры:
#   /sound:sys:alsa      звук
#   /bpp:32              полная цветность (по умолчанию 16 — быстрее)
#   +fonts /gfx          сглаживание шрифтов / RDP GFX
#RDP_EXTRA=/sound:sys:alsa

# --- Киоск: автоподключение при загрузке ----------------------------------
# ip/имя сервера, или список через запятую (failover: пробуем по порядку до
# первого живого). Клиент один раз за загрузку идёт в RDP; после выхода из
# сессии — обычное меню.
#AUTOCONNECT=192.168.0.4
#AUTOCONNECT=192.168.0.4,192.168.0.5,ts-backup

# --- Сеть -----------------------------------------------------------------
# Имя хоста вместо tc-<mac> (видно в DHCP-lease и в RDP-сессии на сервере).
#HOSTNAME=buh-01

# Статический IP вместо DHCP. Пусто/закомментировано → DHCP на всех
# интерфейсах (по умолчанию). Задавай ТРИ ключа вместе: без GATEWAY не будет
# маршрута по умолчанию, без DNS — не будет резолвинга имён.
#STATIC_IP=192.168.0.50/24
#GATEWAY=192.168.0.1
#DNS=192.168.0.1

# --- Время и раскладка ----------------------------------------------------
# NTP-сервер для синхронизации часов. Нужен для RDP-логина (NLA/Kerberos не
# пускают при расхождении времени, а RTC на клиенте может врать/сесть).
#NTP_SERVER=192.168.0.1

# Раскладка консоли для tty2-логина и ввода в меню (например us, ru, de).
# RDP-раскладку задавай через RDP_EXTRA (напр. /kbd:0x00000409).
#KEYMAP=us

# Ждать IP перед показом меню: WAIT_FOR_IP=секунды (пусто/0 = не ждать).
# Экран "Waiting for network..."; любая клавиша — пропустить; по таймауту без
# IP — "обратитесь к администратору", клавиша -> меню. Удобно с AUTOCONNECT.
#WAIT_FOR_IP=60

# --- Принтер (проброс в RDP-сессию) ---------------------------------------
# СЕТЕВОЙ принтер: URI устройства. Клиент создаёт RAW-очередь CUPS и
# пробрасывает её в сессию (xfreerdp /printer уже включён) — Windows печатает
# на неё своим драйвером. Форматы URI:
#   socket://ip:9100        JetDirect/AppSocket (самый частый для сетевых МФУ)
#   lpd://ip/queue          LPD/LPR
#   ipp://host/ipp/print    IPP (ipps:// — с TLS)
# USB-принтер здесь не настраивается (нужен драйвер/PPD на клиенте) — печатай
# на него как на сетевой через принт-сервер, либо ставь драйвер на RDP-сервере.
#PRINTER=socket://192.168.0.20:9100
# Имя очереди — так принтер увидит Windows (по умолчанию "printer").
#PRINTER_NAME=office
