# Список серверов тонкого клиента.
# Формат: имя;ip[:порт][;протокол][;логин]  — настройки СВОИ у каждого сервера
#   протокол: rdp (обычный RDP без NLA/TLS) | tls | nla; пусто = авто
#   логин: для этого сервера (иначе дефолт RDP_USER из tc.conf);
#          домен, если нужен, пишется в логине: CORP\user или user@corp.local
# Имена — латиницей (кириллицу консольный шрифт по умолчанию не покажет).
# Файл лежит на FAT-разделе флешки; правится из меню Manage servers
# (Enter на сервере — его настройки).
srv1;192.168.0.4
# примеры:
#srv2;192.168.0.5:3390;rdp
#srv3;192.168.0.6;;CORP\sklad_user
