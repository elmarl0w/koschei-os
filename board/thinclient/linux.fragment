# Всё встроено в ядро (=y), чтобы не возиться с модулями в initramfs

# devtmpfs, чтобы /dev наполнялся сам
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# UEFI-загрузка: консоль на GOP-framebuffer от прошивки
CONFIG_EFI=y
CONFIG_FB_EFI=y
CONFIG_SYSFB_SIMPLEFB=y

# Watchdog: зависшую коробку само перезагрузит. ITCO — Intel (атомы/чипсеты),
# SP5100 — AMD, i6300ESB — виртуалки (QEMU -watchdog), softdog — фоллбэк.
CONFIG_WATCHDOG=y
CONFIG_WATCHDOG_CORE=y
CONFIG_ITCO_WDT=y
CONFIG_ITCO_VENDOR_SUPPORT=y
CONFIG_SP5100_TCO=y
CONFIG_I6300ESB_WDT=y
CONFIG_SOFT_WATCHDOG=y

# Графика: framebuffer-консоль для меню.
# i915 — старые чипсеты 945GSE (Atom N270 и т.п.), даёт KMS.
# gma500 — Poulsbo/Cedar Trail (GMA 500/600/3600/3650), KMS без ускорения — для RDP хватает.
CONFIG_FB=y
CONFIG_FB_VESA=y
# FB_SIMPLE (fbdev поверх firmware-fb) ОТКЛЮЧЁН: X-драйвер fbdev поверх него
# на ядре 6.16 портит кучу при отрисовке RDP (Fatal glibc malloc на GMA3150).
# Firmware-framebuffer забирает DRM_SIMPLEDRM -> /dev/dri/card0 -> X идёт через
# стабильный modesetting, а не fbdev. (safe-режим: i915.modeset=0, i915 не
# трогает GPU и не виснет, simpledrm поднимает KMS из VESA-буфера.)
# CONFIG_FB_SIMPLE is not set
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_DRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_AGP=y
CONFIG_AGP_INTEL=y
CONFIG_DRM_I915=y
CONFIG_DRM_GMA500=y

# Флешка: USB + vfat (OHCI — USB 1.1 на старых AMD/VIA чипсетах)
CONFIG_USB=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_UHCI_HCD=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_STORAGE=y

# Встроенные SD-ридеры
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PCI=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y

# Загрузка с ISO (тест в виртуалке: ISO подключается как CD)
CONFIG_ISO9660_FS=y
CONFIG_BLK_DEV_SR=y

# Виртуальные GPU (UTM/QEMU/VirtualBox): KMS-framebuffer высокого разрешения
# вместо текстового режима 80x25 — консоль чётче, X работает без vga=-хаков
CONFIG_DRM_BOCHS=y
CONFIG_DRM_CIRRUS_QEMU=y
CONFIG_DRM_VMWGFX=y

# Десктопные GPU (универсальность): NVIDIA через nouveau, старые AMD через
# radeon — нативное разрешение без ускорения; новые AMD остаются на VESA
CONFIG_DRM_NOUVEAU=y
CONFIG_DRM_RADEON=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_VIRTIO_NET=y

# Сетевухи: атомные тонкие клиенты/неттопы + виртуалки + типовые десктопы
# (универсальность: образ должен завестись на любом проводном железе)
CONFIG_E1000=y
CONFIG_E1000E=y
CONFIG_E100=y
CONFIG_R8169=y
CONFIG_8139TOO=y
CONFIG_ATL1C=y
CONFIG_ATL1E=y
CONFIG_SKY2=y
CONFIG_PCNET32=y
CONFIG_TIGON3=y
CONFIG_IGB=y
CONFIG_IGC=y
CONFIG_ALX=y
CONFIG_VIA_RHINE=y
CONFIG_FORCEDETH=y
CONFIG_SKGE=y

# USB-ethernet адаптеры — спасение на железе с экзотической сетевухой
CONFIG_USB_USBNET=y
CONFIG_USB_NET_AX8817X=y
CONFIG_USB_NET_AX88179_178A=y
CONFIG_USB_RTL8152=y
CONFIG_USB_NET_CDCETHER=y

# Ввод для X
CONFIG_INPUT_EVDEV=y

# USB-принтеры (проброс в RDP-сессию через CUPS + канал printer)
CONFIG_USB_PRINTER=y
