# ===================================================================
# site.env — ЕДИНЫЙ конфиг образа тонкого клиента.
#
# Скопируй в site.env (он в .gitignore) и правь ТОЛЬКО этот файл — всё
# запекается в образ при сборке:   ./build.sh
#
#   cp site.env.example site.env
#   nano site.env
#   ./build.sh
#
# Пустое значение = не задавать (работает дефолт системы). Значения —
# латиницей (кириллицу консольный шрифт не покажет). Файл читается сборкой
# как обычный shell (KEY=value), поэтому значения с пробелами — в кавычки.
# ===================================================================

# ---------- Пароли ----------
# Можно ОТКРЫТЫМ ТЕКСТОМ (система сама зашифрует) ИЛИ готовым хэшем ($6$...).
# Хэш посчитать:  mkpasswd -m sha-512 'пароль'   или   openssl passwd -6 'пароль'
ROOT_PASSWORD=
# Непривилегированный пользователь для входа по SSH (+ sudo). Имя настраивается.
USER_NAME=user
USER_PASSWORD=1234
# Пароль на раздел Settings (управление серверами / сеть / консоль).
# Пусто = Settings без пароля. Текст или готовый sha256 (64 hex-символа).
SETTINGS_PASSWORD=

# ---------- Сеть ----------
# Имя хоста НЕ задаём — присваивается само (tc-<mac>), видно в DHCP и на сервере.
STATIC_IP=            # напр. 192.168.0.50/24 ; пусто = DHCP на всех интерфейсах
GATEWAY=
DNS=
NTP_SERVER=          # нужен для RDP-логина, если на клиенте врут часы (NLA)
KEYMAP=us
# Ждать IP перед показом меню: WAIT_FOR_IP=секунды (пусто/0 = не ждать).
# Показывает "Waiting for network...", любая клавиша — пропустить; по таймауту
# без IP — экран "обратитесь к администратору", клавиша -> меню. Удобно с
# AUTOCONNECT (не дёргать RDP, пока сети нет).
WAIT_FOR_IP=

# ---------- RDP по умолчанию ----------
RDP_USER=            # предзаполнить логин в окне входа RDP
RDP_DOMAIN=
# Протокол безопасности RDP: пусто/auto = согласование (по умолчанию),
#   rdp = обычный RDP без NLA/TLS (для серверов, где NLA/TLS выключены),
#   tls = только TLS, nla = только NLA.
RDP_SECURITY=
RDP_EXTRA=           # доп. флаги xfreerdp, напр. /sound:sys:alsa /bpp:32
AUTOCONNECT=         # ip/имя, или список через запятую (failover): a,b,c

# ---------- Принтер (сетевой, проброс в RDP-сессию) ----------
PRINTER=             # напр. socket://192.168.0.20:9100 (или lpd://, ipp://)
PRINTER_NAME=        # имя очереди, как увидит Windows (по умолчанию printer)

# ---------- Серверы RDP (по строке: Имя=адрес[:порт][;протокол]) ----------
# протокол (rdp/tls/nla) — свой для КАЖДОГО сервера (переопределяет
# RDP_SECURITY выше), напр.:  Buh=192.168.0.5:3390;rdp
# Раскомментируй и добавляй свои. Это стартовый список; из меню его тоже можно
# править (на usb.img — пишется на флешку).
SERVERS="
# Parus=192.168.0.4
# Buh=192.168.0.5:3390
"
