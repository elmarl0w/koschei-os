# Архитектура: 32-битный x86, заведётся на любом Atom, включая N270/N280.
# Если весь парк точно 64-битный (D525/N2600+) — замени на BR2_x86_64=y + BR2_x86_atom=y.
BR2_i386=y
BR2_x86_i686=y

# Тулчейн: glibc (Xorg и FreeRDP с ним собираются без сюрпризов), C++ нужен зависимостям
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y

BR2_TARGET_GENERIC_HOSTNAME="thinclient"
BR2_TARGET_GENERIC_ISSUE="KoscheiOS"
# Пароль root (SSH + логин на tty2). ВНИМАНИЕ: значение ниже — НЕБЕЗОПАСНАЯ
# заглушка «CHANGE THIS», не рабочий пароль. Задавай свой при сборке:
#   TC_ROOT_PASSWORD='свой-пароль' ./build.sh   (durable, вписывается в образ)
# либо интерактивно `passwd` в консоли (эфемерно — сбросится при перезагрузке,
# система в RAM). SHA512 — чтобы хэш был $6$, а не слабый $5$.
BR2_TARGET_GENERIC_PASSWD_SHA512=y
BR2_TARGET_GENERIC_ROOT_PASSWD="CHANGEME-INSECURE-DEFAULT"

# eudev нужен, чтобы Xorg сам находил клавиатуру/мышь/видео без ручного xorg.conf
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_EUDEV=y

BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_THINCLIENT_PATH)/board/thinclient/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_THINCLIENT_PATH)/board/thinclient/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_THINCLIENT_PATH)/board/thinclient/post-image.sh"

# Таблица пользователей ГЕНЕРИТСЯ build.sh в .site/users.table из site.env
# (имя/пароль user). Без site.env — дефолт user/1234. Файл .site/ в .gitignore.
BR2_ROOTFS_USERS_TABLES="$(BR2_EXTERNAL_THINCLIENT_PATH)/.site/users.table"

# Ядро: дефолтный конфиг арха + наш фрагмент (fb, i915/gma500, сетевухи, vfat, usb)
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_USE_ARCH_DEFAULT_CONFIG=y
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_THINCLIENT_PATH)/board/thinclient/linux.fragment"

# Минимальный X: только сервер, драйверы и xinit — ни WM, ни DE
BR2_PACKAGE_XORG7=y
BR2_PACKAGE_XSERVER_XORG_SERVER=y
BR2_PACKAGE_XDRIVER_XF86_INPUT_LIBINPUT=y
BR2_PACKAGE_XDRIVER_XF86_VIDEO_FBDEV=y
BR2_PACKAGE_XDRIVER_XF86_VIDEO_INTEL=y
BR2_PACKAGE_XAPP_XINIT=y
BR2_PACKAGE_XAPP_XAUTH=y

# FreeRDP 2.11 (клиент xfreerdp) — в Buildroot 2025.08 это ещё 2.x
BR2_PACKAGE_FREERDP=y
BR2_PACKAGE_FREERDP_CLIENT_X11=y

# Свои патчи пакетов (patches/<пакет>/*.patch), сейчас там только psplash:
# тёмная тема + убран логотип poky
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_THINCLIENT_PATH)/patches"

# Заставка с прогресс-баром на загрузке (рисует прямо в framebuffer)
BR2_PACKAGE_PSPLASH=y

# Консольное меню: свой ncurses-лаунчер; kbd — консольные шрифты.
# dialog не нужен — UI полностью на tc-launcher (см. post-build: удаляем
# бинарь и dialogrc, если остались от прошлых сборок).
BR2_PACKAGE_TC_LAUNCHER=y
BR2_PACKAGE_NCURSES_WCHAR=y
BR2_PACKAGE_KBD=y

# bash для пункта «Консоль Linux».
# SHOW_OTHERS обязателен: без него Kconfig молча выбрасывает bash
# как «дубликат» busybox-шелла
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
BR2_PACKAGE_BASH=y

# Фрагмент конфига busybox: включает ntpd (синхронизация времени для NLA)
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_THINCLIENT_PATH)/board/thinclient/busybox.fragment"

# TLS-сертификаты (если захочется убрать /cert:ignore)
BR2_PACKAGE_CA_CERTIFICATES=y

# Прошивки для свежих Realtek-сетевух: 8169 (PCI) и 8152/8153 (USB).
# ВНИМАНИЕ: RTL_81XX — это Wi-Fi (rtlwifi), не то
BR2_PACKAGE_LINUX_FIRMWARE=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_8169=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_815X=y

# Стандартные сетевые утилиты: ip/ss, ping/tracepath, ethtool, tcpdump
BR2_PACKAGE_IPROUTE2=y
BR2_PACKAGE_IPUTILS=y
BR2_PACKAGE_ETHTOOL=y
BR2_PACKAGE_TCPDUMP=y

# Удалённый доступ и админ-утилиты: sshd (dropbear, автостарт), htop,
# mc, nano, vim (без runtime — экономия ~25 МБ; vi даёт busybox)
BR2_PACKAGE_DROPBEAR=y
BR2_PACKAGE_HTOP=y
BR2_PACKAGE_MC=y
BR2_PACKAGE_NANO=y
BR2_PACKAGE_VIM=y
# BR2_PACKAGE_VIM_RUNTIME is not set

# sudo + shadow: sudo для user, полноценные useradd/usermod/userdel/groupadd
# (busybox даёт только adduser). Даёт админу заводить юзеров в рантайме.
BR2_PACKAGE_SUDO=y
BR2_PACKAGE_SHADOW=y

# Принтеры: CUPS на клиенте + канал printer в FreeRDP; lsusb для диагностики
BR2_PACKAGE_CUPS=y
BR2_PACKAGE_USBUTILS=y

# Первая загрузка с ISO-флешки: создание конфиг-раздела TCDATA
# в свободном месте (sfdisk из util-linux basic set — отдельной опции
# для sfdisk у Buildroot нет) и его форматирование (mkfs.vfat)
BR2_PACKAGE_UTIL_LINUX=y
BR2_PACKAGE_UTIL_LINUX_BINARIES=y
BR2_PACKAGE_DOSFSTOOLS=y
BR2_PACKAGE_DOSFSTOOLS_MKFS_FAT=y

# UEFI-загрузка: grub-efi НЕ отсюда — Buildroot на i686 не умеет собрать
# x86_64-efi (а он нужен всем современным компам). Оба bootx64/bootia32
# генерятся grub-mkstandalone в amd64-шаге post-image (см. Dockerfile).

# rootfs целиком в RAM: initramfs cpio+gzip, никакого раздела с системой
BR2_TARGET_ROOTFS_CPIO=y
BR2_TARGET_ROOTFS_CPIO_GZIP=y
# BR2_TARGET_ROOTFS_TAR is not set
